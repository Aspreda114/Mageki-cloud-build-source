<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Opt-in: normal IDE builds retain their original signing settings. -->
  <PropertyGroup Condition="'$(MagekiUnsignedIpa)' == 'true' And '$(Configuration)|$(Platform)' == 'Release|iPhone'">
    <BuildIpa>true</BuildIpa>
    <ArchiveOnBuild>false</ArchiveOnBuild>
    <EnableCodeSigning>false</EnableCodeSigning>
    <CodesignRequireProvisioningProfile>false</CodesignRequireProvisioningProfile>
    <CodesignEntitlements />
    <CodesignKey />
    <CodesignProvision />
    <MtouchArch>ARM64</MtouchArch>
    <MtouchSdkVersion>18.2</MtouchSdkVersion>
    <MtouchLink>SdkOnly</MtouchLink>
    <MtouchUseLlvm>false</MtouchUseLlvm>
    <!-- Use the classic native linker still shipped with Xcode 16.2. -->
    <MtouchExtraArgs>$(MtouchExtraArgs) --gcc_flags=-Wl,-ld_classic</MtouchExtraArgs>
  </PropertyGroup>
</Project>
